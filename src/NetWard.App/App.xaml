<Application x:Class="NetWard.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:NetWard.App.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Value Converters -->
        <converters:StatusToBrushConverter x:Key="StatusBrushConverter"/>
        <converters:StatusToLabelConverter x:Key="StatusLabelConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- Color Brushes -->
        <SolidColorBrush x:Key="BgPrimary" Color="#0D0E11"/>
        <SolidColorBrush x:Key="BgSurface" Color="#16181D"/>
        <SolidColorBrush x:Key="BgCard" Color="#1D2027"/>
        <SolidColorBrush x:Key="BgCardHover" Color="#252932"/>
        <SolidColorBrush x:Key="BorderSubtle" Color="#2A2E39"/>
        <SolidColorBrush x:Key="BorderFocus" Color="#3E4453"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#9CA3AF"/>
        <SolidColorBrush x:Key="TextMuted" Color="#606774"/>
        <SolidColorBrush x:Key="AccentEmerald" Color="#00E599"/>
        <SolidColorBrush x:Key="AccentCrimson" Color="#FF334B"/>

        <!-- Button Style -->
        <Style x:Key="PrimaryActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#00E599"/>
            <Setter Property="Foreground" Value="#0D0E11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#17F3AB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#1D2027"/>
            <Setter Property="Foreground" Value="#F3F4F6"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderBrush" Value="#2A2E39"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#252932"/>
                    <Setter Property="BorderBrush" Value="#3E4453"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
