<Window x:Class="NetWard.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:NetWard.App.ViewModels"
        xmlns:models="clr-namespace:NetWard.Core.Models;assembly=NetWard.Core"
        mc:Ignorable="d"
        Title="NetWard — Монитор устойчивости сети и доступности сервисов"
        Height="760" Width="1080"
        MinHeight="650" MinWidth="900"
        Background="#0D0E11"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Action Bar -->
            <RowDefinition Height="Auto"/> <!-- Progress Bar -->
            <RowDefinition Height="*"/>    <!-- Main Tabs -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#16181D" BorderBrush="#2A2E39" BorderThickness="0,0,0,1" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1D2027" BorderBrush="#3E4453" BorderThickness="1" CornerRadius="12" Width="44" Height="44" Margin="0,0,16,0">
                        <TextBlock Text="🛡️" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="NETWARD" FontSize="20" FontWeight="Bold" Foreground="#F3F4F6"/>
                            <Border Background="#1D2027" CornerRadius="6" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="v1.0.0" FontSize="11" FontWeight="SemiBold" Foreground="#00E599"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Честная диагностика доступности сервисов и игровых серверов" FontSize="13" Foreground="#9CA3AF" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Top Right Badges -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1D2027" BorderBrush="#2A2E39" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,8,0">
                        <TextBlock Text="🔒 100% Local-First" FontSize="12" Foreground="#9CA3AF"/>
                    </Border>
                    <Border Background="#1D2027" BorderBrush="#2A2E39" BorderThickness="1" CornerRadius="8" Padding="10,6">
                        <TextBlock Text="🚫 Zero Tracking" FontSize="12" Foreground="#9CA3AF"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ACTION TOOLBAR -->
        <Border Grid.Row="1" Background="#0D0E11" Padding="24,14" BorderBrush="#2A2E39" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource PrimaryActionBtn}" Command="{Binding RunDiagnosisCommand}" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚡" Margin="0,0,6,0"/>
                            <TextBlock Text="Проверить всё"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SecondaryActionBtn}" Command="{Binding RunGameRadarCommand}" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎮" Margin="0,0,6,0"/>
                            <TextBlock Text="Игровой радар"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SecondaryActionBtn}" Command="{Binding FlushDnsCommand}" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧹" Margin="0,0,6,0"/>
                            <TextBlock Text="Очистить DNS"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Simulation Mode Selector -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Режим:" FontSize="13" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Width="250" Height="32" 
                              Background="#16181D" Foreground="#F3F4F6" BorderBrush="#2A2E39"
                              SelectedValuePath="Tag"
                              SelectedValue="{Binding SelectedSimulation, Mode=TwoWay}">
                        <ComboBoxItem Content="🌐 Реальная сеть" Tag="{x:Static models:SimulationMode.RealNetwork}"/>
                        <ComboBoxItem Content="⚠️ Симуляция: Блок Discord (ТСПУ)" Tag="{x:Static models:SimulationMode.SimulateDiscordBlocked}"/>
                        <ComboBoxItem Content="⚠️ Симуляция: Замедление YouTube" Tag="{x:Static models:SimulationMode.SimulateYouTubeThrottled}"/>
                        <ComboBoxItem Content="⚠️ Симуляция: Сбой сервера" Tag="{x:Static models:SimulationMode.SimulateServerOutage}"/>
                        <ComboBoxItem Content="⚠️ Симуляция: DNS-подмена" Tag="{x:Static models:SimulationMode.SimulateDnsPoisoning}"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- PROGRESS BAR -->
        <ProgressBar Grid.Row="2" Height="3" Value="{Binding Progress}" 
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}"
                     Foreground="#00E599" Background="#16181D" BorderThickness="0"/>

        <!-- MAIN TABS -->
        <TabControl Grid.Row="3" Background="#0D0E11" BorderThickness="0" Margin="24,12,24,0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="#9CA3AF"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="16,10"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border Name="Border" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Margin="0,0,12,8">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="BorderBrush" Value="#00E599"/>
                                        <Setter Property="Foreground" Value="#F3F4F6"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- TAB 1: SERVICES -->
            <TabItem Header="🌐 Доступность сервисов">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <ItemsControl ItemsSource="{Binding Services}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#16181D" BorderBrush="#2A2E39" BorderThickness="1" CornerRadius="12" Margin="0,0,0,10" Padding="18,14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Card Header Row -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Glyph -->
                                            <Border Background="#1D2027" CornerRadius="8" Width="38" Height="38" Margin="0,0,14,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Profile.IconGlyph}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Name & Category -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Profile.DisplayName}" FontSize="16" FontWeight="SemiBold" Foreground="#F3F4F6"/>
                                                    <Border Background="#1D2027" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding Profile.Category}" FontSize="11" Foreground="#9CA3AF"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="#9CA3AF" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- Latency -->
                                            <TextBlock Grid.Column="2" Text="{Binding LatencyLabel}" FontSize="13" FontFamily="Consolas" Foreground="#9CA3AF" 
                                                       VerticalAlignment="Center" Margin="0,0,18,0"/>

                                            <!-- Status Badge -->
                                            <Border Grid.Column="3" CornerRadius="6" Padding="10,4" Margin="0,0,14,0" VerticalAlignment="Center"
                                                    Background="{Binding Status, Converter={StaticResource StatusBrushConverter}}">
                                                <TextBlock Text="{Binding StatusLabel}" FontSize="11" FontWeight="Bold" Foreground="#0D0E11"/>
                                            </Border>

                                            <!-- Expand Toggle Button -->
                                            <ToggleButton Grid.Column="4" IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                          Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center">
                                                <TextBlock Text="▼" FontSize="11" Foreground="#9CA3AF"/>
                                            </ToggleButton>
                                        </Grid>

                                        <!-- Expanded Details Drawer -->
                                        <Border Grid.Row="1" Background="#1D2027" BorderBrush="#2A2E39" BorderThickness="1" CornerRadius="8" 
                                                Margin="0,12,0,0" Padding="14"
                                                Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisConverter}}">
                                            <StackPanel>
                                                <TextBlock Text="🔬 ТЕХНИЧЕСКИЙ ДИАГНОЗ:" FontSize="11" FontWeight="Bold" Foreground="#00E599" Margin="0,0,0,4"/>
                                                <TextBlock Text="{Binding TechnicalDetails}" FontSize="13" Foreground="#F3F4F6" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                                <TextBlock Text="💡 ДЕЙСТВИЕ / РЕКОМЕНДАЦИЯ:" FontSize="11" FontWeight="Bold" Foreground="#FFB300" Margin="0,0,0,4"/>
                                                <TextBlock Text="{Binding Recommendation}" FontSize="13" Foreground="#F3F4F6" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: GAMING RADAR -->
            <TabItem Header="🎯 Игровой радар (Пинг и потери)">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <Border Background="#16181D" BorderBrush="#2A2E39" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,0,0,14">
                            <TextBlock Text="⚡ Радар измеряет многопакетный пинг, джиттер (колебания задержки) и процент потерь пакетов до основных европейских серверов Counter-Strike 2, Dota 2, Roblox и Minecraft." 
                                       FontSize="13" Foreground="#9CA3AF" TextWrapping="Wrap"/>
                        </Border>

                        <ItemsControl ItemsSource="{Binding GameResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#16181D" BorderBrush="#2A2E39" BorderThickness="1" CornerRadius="10" Margin="0,0,0,8" Padding="16,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Game & Region -->
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding GameName}" FontSize="15" FontWeight="SemiBold" Foreground="#F3F4F6"/>
                                                <TextBlock Text="{Binding Region}" FontSize="12" Foreground="#9CA3AF"/>
                                            </StackPanel>

                                            <!-- Avg Ping -->
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,24,0">
                                                <TextBlock Text="СРЕДНИЙ ПИНГ" FontSize="10" Foreground="#9CA3AF" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding AvgLatencyMs, StringFormat={}{0:F0} ms}" FontSize="15" FontWeight="Bold" FontFamily="Consolas" Foreground="#00E599" HorizontalAlignment="Right"/>
                                            </StackPanel>

                                            <!-- Jitter -->
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,24,0">
                                                <TextBlock Text="ДЖИТТЕР" FontSize="10" Foreground="#9CA3AF" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding JitterMs, StringFormat={}±{0:F1} ms}" FontSize="14" FontFamily="Consolas" Foreground="#F3F4F6" HorizontalAlignment="Right"/>
                                            </StackPanel>

                                            <!-- Packet Loss -->
                                            <StackPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="ПОТЕРИ" FontSize="10" Foreground="#9CA3AF" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding PacketLossPct, StringFormat={}{0:F0}%}" FontSize="14" FontFamily="Consolas" Foreground="#FF334B" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: NETWORK & DNS -->
            <TabItem Header="📡 Сеть и DNS">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <!-- Gateway Card -->
                        <Border Background="#16181D" BorderBrush="#2A2E39" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="🏠 ЛОКАЛЬНЫЙ ШЛЮЗ (WI-FI / РОУТЕР)" FontSize="12" FontWeight="Bold" Foreground="#00E599" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding LocalStatus.GatewayIp, StringFormat='Шлюз роутера: {0}', TargetNullValue='Шлюз: Не обнаружен'}" FontSize="15" Foreground="#F3F4F6" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding LocalStatus.GatewayPingMs, StringFormat='Задержка до роутера: {0:F1} ms', TargetNullValue='Задержка до роутера: --'}" FontSize="13" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding LocalStatus.InterfaceName, StringFormat='Интерфейс: {0}'}" FontSize="13" Foreground="#9CA3AF"/>
                            </StackPanel>
                        </Border>

                        <!-- DNS Health Card -->
                        <Border Background="#16181D" BorderBrush="#2A2E39" BorderThickness="1" CornerRadius="12" Padding="20">
                            <StackPanel>
                                <TextBlock Text="🛡️ ЗАЩИТА ОТ DNS-ПОДМЕНЫ" FontSize="12" FontWeight="Bold" Foreground="#00E599" Margin="0,0,0,8"/>
                                <TextBlock Text="NetWard сравнивает ответы системного DNS-сервера с защищёнными шифрованными DoH-серверами Cloudflare (1.1.1.1) и Quad9 (9.9.9.9)." 
                                           FontSize="13" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                <Button Style="{StaticResource SecondaryActionBtn}" Command="{Binding FlushDnsCommand}" HorizontalAlignment="Left">
                                    <TextBlock Text="🧹 Очистить системный кэш DNS (Flush DNS)"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 4: EXPORT REPORT -->
            <TabItem Header="📋 Экспорт отчёта">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#16181D" BorderBrush="#2A2E39" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                        <Grid>
                            <TextBlock Text="Отчёт автоматически очищен от ваших персональных IP-адресов и готов для отправки в GitHub issues или друзьям." 
                                       FontSize="13" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource PrimaryActionBtn}" Command="{Binding CopyReportCommand}" HorizontalAlignment="Right">
                                <TextBlock Text="📄 Скопировать отчёт"/>
                            </Button>
                        </Grid>
                    </Border>

                    <TextBox Grid.Row="1" Text="{Binding ReportMarkdown, Mode=OneWay}" IsReadOnly="True"
                             Background="#16181D" Foreground="#9CA3AF" BorderBrush="#2A2E39" BorderThickness="1"
                             FontFamily="Consolas" FontSize="12" Padding="14" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- STATUS BAR -->
        <Border Grid.Row="4" Background="#16181D" BorderBrush="#2A2E39" BorderThickness="0,1,0,0" Padding="24,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#00E599" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#F3F4F6"/>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="NetWard • 100% Free Open Source Software • Apache-2.0" FontSize="11" Foreground="#606774"/>
            </Grid>
        </Border>
    </Grid>
</Window>
